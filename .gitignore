# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# O projeto usa Yarn (packageManager em package.json); lockfiles de outros
# gerenciadores nao devem ser versionados para evitar arvores de node_modules
# divergentes/duplicadas entre workspaces.
package-lock.json
apps/*/package-lock.json
packages/*/package-lock.json

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem
