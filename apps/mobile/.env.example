# URL da API backend usada pelo app mobile (Expo)
# Dev local: ajuste para IP da sua maquina quando usar celular fisico
# Exemplo: EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:3001
EXPO_PUBLIC_API_BASE_URL=https://neto-bastos.onrender.com

# Client ID (tipo "Android") criado no Google Cloud Console para o
# pacote com.netobastos.app, usado pelo login "Continuar com Google".
# Sem essa variavel o botao de login com Google fica oculto.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
