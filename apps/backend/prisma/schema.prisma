generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatusAgendamento {
  PENDENTE
  CONFIRMADO
  CANCELADO
}

enum RoleUsuario {
  CLIENTE
  BARBEIRO
  DONO
}

model Profissional {
  id                   Int           @id @default(autoincrement())
  nome                 String
  descricao            String
  imagemUrl            String
  avaliacao            Float
  quantidadeAvaliacoes Int
  diasTrabalho         Int[]         @default([1, 2, 3, 4, 5, 6])
  horaInicio           String        @default("08:00")
  horaFim              String        @default("19:00")
  tempoSlotMinutos     Int           @default(15)
  agendamentos         Agendamento[]
  usuario              Usuario?

  @@map("profissional")
}

model Servico {
  id           Int           @id @default(autoincrement())
  nome         String        @unique
  descricao    String
  preco        Float
  qtdeSlots    Int
  imagemURL    String
  agendamentos Agendamento[]

  @@map("servico")
}

model Agendamento {
  id             Int               @id @default(autoincrement())
  emailCliente   String
  status         StatusAgendamento @default(PENDENTE)
  data           DateTime          @db.Timestamptz(3)
  profissional   Profissional      @relation(fields: [profissionalId], references: [id])
  profissionalId Int
  servicos       Servico[]

  @@map("agendamento")
}

model Usuario {
  id             Int           @id @default(autoincrement())
  email          String        @unique
  nome           String
  telefone       String?
  role           RoleUsuario   @default(CLIENTE)
  profissionalId Int?          @unique
  profissional   Profissional? @relation(fields: [profissionalId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("usuario")
}
